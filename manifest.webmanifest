{
  "id": "/",
  "name": "WhatsGram OS",
  "short_name": "WhatsGram",
  "description": "End-to-end encrypted messaging, WebRTC calling, Stories, Reels, Explore Feed, and AI Assistant.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    { "name": "Messages", "short_name": "Chats", "url": "/chats" },
    { "name": "Explore Feed", "short_name": "Explore", "url": "/feed" },
    { "name": "WhatsGram AI", "short_name": "AI", "url": "/ai" },
    { "name": "Incognito Mode", "short_name": "Incognito", "url": "/incognito" }
  ],
  "share_target": {
    "action": "/chats",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
