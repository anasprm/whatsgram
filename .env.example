# ==============================================================================
# WhatsGram OS — Environment Variables Template
# Copy to `.env.local` for local `vercel dev` or configure in Vercel Settings.
# Never commit real secret values to git.
# ==============================================================================

# --- Core: Supabase (Required for cloud auth, Postgres, Storage, Realtime) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy Supabase key names (supported automatically as fallbacks):
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- AI Copilot (Configure one or more; falls back to local AI if unset) -----
# Primary fast OpenAI-compatible inference (Groq)
GROQ_API_KEY=gsk_replace_me
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=

# Automatic failover & vision routing (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-replace_me
# OPENROUTER_MODEL=openrouter/free

# Optional Google Gemini fallback (AI Studio `AIza...` or Vertex Express `AQ.`)
# GEMINI_API_KEY=AIza_replace_me
# GEMINI_MODEL=gemini-2.5-flash

# --- Application Origin & Scheduled Maintenance -------------------------------
APP_URL=https://your-deployment-domain.vercel.app
# Protect `/api/cron` (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_SECRET=replace_with_64_char_random_hex

# --- Optional: Background Web Push Notifications ------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VAPID_SUBJECT=mailto:security@example.com

# --- Optional: WebRTC TURN Relay (Calls behind strict NAT/firewalls) ----------
# Comma-separated turn:/turns: URLs (or JSON array starting with `[`)
TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_USERNAME=replace_with_turn_username
TURN_CREDENTIAL=replace_with_turn_credential

# --- Optional: Password-Reset Emails via Resend -------------------------------
# Omit if using Supabase Custom SMTP or in-app self-reset links only
RESEND_API_KEY=re_replace_me
# RESEND_FROM=WhatsGram OS <noreply@yourdomain.com>
